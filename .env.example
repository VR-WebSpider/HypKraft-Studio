# ==============================================================================
# HypKraft Studio - Environment Configuration Template
# NOTE: HypKraft is 100% standalone out-of-the-box. No API keys are required
# to run the core video editor, 3D motion graphics, or procedural audio.
# ==============================================================================

# Active LLM Reasoning Provider: 'standalone', 'cloud-gemini', 'cloud-openai', 'local-ollama'
ACTIVE_LLM_PROVIDER=standalone

# Active Sound Synthesis: 'built-in-synth', 'cloud-elevenlabs', 'local-audiocraft'
ACTIVE_SOUND_PROVIDER=built-in-synth

# Active Visual Provider: 'three-webgl', 'local-comfyui', 'cloud-replicate'
ACTIVE_VISUAL_PROVIDER=three-webgl

# Optional Cloud API Keys (Leave blank for offline standalone usage)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# Local Model Endpoints (Optional local AI backends)
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234/v1
COMFYUI_URL=http://localhost:8188
AUDIOCRAFT_URL=http://localhost:8001

# Model Context Protocol (MCP) Server Configuration
HYPKRAFT_MCP_PORT=8000
HYPKRAFT_API_TOKEN=hypkraft-local-token
